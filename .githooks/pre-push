#!/bin/sh
# Refuse a push that is not green: the same `make check` CI runs — lint, format,
# types, the architectural contracts and the whole suite, examples included.
#
# No pipe on purpose: `make check | tail` would report the exit status of tail,
# and a red suite would push. Skip only knowingly: git push --no-verify.
set -e
echo "pre-push: make check (git push --no-verify to skip)"
make check
